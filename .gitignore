# Python bytecode and Numba's on-disk JIT cache (written next to the sources)
__pycache__/
*.py[cod]
*.nbi
*.nbc

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Test and lint caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Environments
.venv/
venv/
env/
.env

# Notebooks
.ipynb_checkpoints/

# Editors: share only the workspace settings and recommended extensions
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.code-workspace

# Legacy Cython build products (v3, under legacy/)
legacy/**/*.c
legacy/**/*.so
legacy/**/*.pyd
